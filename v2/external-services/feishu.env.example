# Copy to your private V2 runtime directory as feishu.env. Never commit the filled file.
# Use an explicitly approved V2 table. V1 credentials are never auto-loaded.
FEISHU_SYNC_ENABLED=0
# Enable structured E/F display only after validating the target table and receiver version.
FEISHU_SITE_DISPLAY=0
# V2: each distinct upload is a new row; exact transport retries are idempotent.
FEISHU_LOG_APPEND_ONLY=0
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=
HUIDU_UPLOAD_KEY=

# Optional stable text field ID for log upserts when the visible index is a date.
FEISHU_LOG_KEY_FIELD_ID=
# Optional original native Date field ID; display Date uses YYYY-MM-DD text.
FEISHU_LOG_DATE_FIELD_ID=

# Task-event rollout: legacy uploads archive locally, never qualify as receiver success.
# Does not migrate or drain the old device/day queue into either new task table.
FEISHU_TASK_PROTOCOL_ONLY=0
# Enable only after explicit schema/permission approval and isolated acceptance.
FEISHU_TASK_SYNC_ENABLED=0
# A separate private Base; never reuse the leadership app token here.
FEISHU_FAILURE_APP_TOKEN=
FEISHU_FAILURE_TABLE_ID=
