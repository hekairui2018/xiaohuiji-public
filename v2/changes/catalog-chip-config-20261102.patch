+.chip-series button,.chip-option{padding:5px 8px;font-size:13px;line-height:1.4;border-radius:5px;transition:background-color .15s ease,border-color .15s ease,color .15s ease}
+.chip-series button:hover,.chip-option:hover,.chip-series button:focus-visible,.chip-option:focus-visible{color:#197ca8;background:var(--file-hover);border-color:#acd5e6}
+.chip-content{min-width:0}.chip-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:5px;max-height:340px;overflow:auto;padding:2px}
+.chip-grid>strong{grid-column:1/-1}.chip-option{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
 .chip-detail:not(:empty){margin-top:14px;padding:12px;border:1px solid var(--border);border-radius:8px}.chip-detail p{margin:8px 0}.chip-detail small{display:block;margin:8px 0;color:var(--text-muted)}
 .chip-series-select{display:none;width:100%;margin-bottom:10px}
-@media(max-width:640px){.chip-browser-layout{grid-template-columns:minmax(0,1fr)}.chip-series{display:none}.chip-series-select{display:block}.chip-grid{grid-template-columns:repeat(auto-fit,minmax(120px,1fr))}}
+@media(max-width:640px){.chip-browser-layout{grid-template-columns:minmax(0,1fr)}.chip-series{display:none}.chip-series-select{display:block}.chip-grid{grid-template-columns:repeat(auto-fill,minmax(100px,1fr))}}
 .v2-source-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:8px}.v2-source-title>strong{min-width:0;overflow-wrap:anywhere}.v2-source-title>.pr-actions{flex-shrink:0;display:flex;gap:8px}.v2-source-title>.pr-actions svg{width:18px;height:18px}
 
