+/* One bounded browsing area below the search controls. */
+body[data-view="quick"]{height:100dvh;overflow:hidden}
+body[data-view="quick"] .site-main{height:calc(100dvh - 78px);margin:12px auto;min-height:0}
+body[data-view="quick"] .search-section{height:100%;min-height:0;display:flex;flex-direction:column;padding-bottom:12px}
+body[data-view="quick"] .search-toolbar{position:relative;top:auto;flex:0 0 auto}
+body[data-view="quick"] .quick-examples{flex:0 0 auto}
+body[data-view="quick"] #searchResults{flex:1 1 auto;min-height:0;overflow-y:scroll;overflow-x:hidden;scrollbar-gutter:stable;overscroll-behavior:contain;padding-right:8px;scrollbar-width:thin;scrollbar-color:#9eb4bf #f1f5f7}
+body[data-view="quick"] #searchResults::-webkit-scrollbar{width:8px}
+body[data-view="quick"] #searchResults::-webkit-scrollbar-track{background:#f1f5f7;border-radius:8px}
+body[data-view="quick"] #searchResults::-webkit-scrollbar-thumb{background:#9eb4bf;border-radius:8px}
+body[data-view="quick"] #searchResults:has(.source-tree-viewport){display:flex!important;flex-direction:column;overflow:hidden}
+body[data-view="quick"] #searchResults .source-tree-viewport{flex:1 1 auto;min-height:0;height:auto;max-height:none}
